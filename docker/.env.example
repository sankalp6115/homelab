# =============================================================================
# Homelab Docker .env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Your timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Asia/Kolkata

# Root directory on the HOST where all container data is stored.
# Use an absolute path for production (e.g. /opt/homelab/data)
# or a relative path for quick local testing (e.g. ./data).
DATA_ROOT=/opt/homelab/data

# -----------------------------------------------------------------------------
# Gotify  (notification server)
# -----------------------------------------------------------------------------

# Host port that maps to Gotify's internal port 80
GOTIFY_PORT=8000

# -----------------------------------------------------------------------------
# Uptime Kuma  (uptime / status monitoring)
# -----------------------------------------------------------------------------

# Host port that maps to Uptime Kuma's internal port 3001
UPTIME_KUMA_PORT=3001

# -----------------------------------------------------------------------------
# Pi-hole  (network-wide DNS ad blocker)
# -----------------------------------------------------------------------------

# Host port for the Pi-hole web UI (maps to internal port 80)
PIHOLE_WEB_PORT=8080

# Upstream DNS servers used by Pi-hole
PIHOLE_DNS1=1.1.1.1
PIHOLE_DNS2=8.8.8.8

# Password for the Pi-hole web interface / FTL API
# Change this before first run!
PIHOLE_WEB_PASSWORD=changeme
